# Mobile app store links (shown on the post-success dialog)
REACT_APP_IOS_APP_URL=https://apps.apple.com/app/id0000000000
REACT_APP_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.mafqoudat.app 