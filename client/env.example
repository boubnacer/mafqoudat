# Client Environment Variables
# Copy this file to .env and fill in your actual values

# API URL (Your Railway backend URL)
REACT_APP_API_URL=https://mafqoudat-production.up.railway.app

# Domain (Your main domain)
REACT_APP_DOMAIN=https://mafqoudat.com

# Cloudinary Configuration (for frontend uploads)
REACT_APP_CLOUDINARY_CLOUD_NAME=du0tmvxhu
REACT_APP_CLOUDINARY_UPLOAD_PRESET=mafqoudat

# Note: REACT_APP_CLOUDINARY_API_SECRET and API_KEY should NOT be in frontend
# Cloudinary uploads will be handled by the backend for security

# Mobile app store links (shown on the post-success dialog)
REACT_APP_IOS_APP_URL=https://apps.apple.com/app/id0000000000
REACT_APP_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.mafqoudat.app 

# Google Analytics measurement ID. Analytics is loaded from
# src/utils/analytics.js only after the consent manager below reports consent.
REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Publisher ID (or Funding Choices "Privacy & messaging" CMP ID).
# Format: pub-0000000000000000 or ca-pub-0000000000000000.
# Injected into the built index.html by scripts/postbuild.js:
# - Injects <meta name="google-adsense-account" content="ca-pub-..."> for account verification
# - Injects Google AdSense script tag
# - Configures Google Funding Choices CMP
# - Automatically populates ads.txt in the build output
REACT_APP_ADSENSE_PUB_ID=pub-0000000000000000
REACT_APP_FC_PUBLISHER_ID=pub-0000000000000000

# Google Search Console Site Verification meta tag content (optional)
REACT_APP_GOOGLE_SITE_VERIFICATION=
