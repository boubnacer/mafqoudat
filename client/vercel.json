{
  "env": {
    "GENERATE_SOURCEMAP": "false"
  },
  "rewrites": [
    {
      "source": "/dash/posts/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterestbot|redditbot|vkShare|SkypeUriPreview|bingbot|BingPreview|Yandex|Googlebot|Google-InspectionTool|Storebot-Google|GoogleOther|AdsBot-Google|DuckDuckBot|Applebot|PetalBot|SeznamBot|Qwantify|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|ClaudeBot|Claude-Web|Amazonbot|YouBot).*"
        }
      ],
      "destination": "https://mafqoudat-production.up.railway.app/og/posts/:id"
    },
    {
      "source": "/dash/posts",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|facebookcatalog|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterestbot|redditbot|vkShare|SkypeUriPreview|bingbot|BingPreview|Yandex|Googlebot|Google-InspectionTool|Storebot-Google|GoogleOther|AdsBot-Google|DuckDuckBot|Applebot|PetalBot|SeznamBot|Qwantify|GPTBot|OAI-SearchBot|ChatGPT-User|PerplexityBot|ClaudeBot|Claude-Web|Amazonbot|YouBot).*"
        }
      ],
      "destination": "https://mafqoudat-production.up.railway.app/og/posts"
    },
    {
      "source": "/sitemap-posts.xml",
      "destination": "https://mafqoudat-production.up.railway.app/sitemap-posts.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/google",
      "destination": "https://mafqoudat-production.up.railway.app/auth/google"
    },
    {
      "source": "/auth/google/callback",
      "destination": "https://mafqoudat-production.up.railway.app/auth/google/callback"
    },
    {
      "source": "/auth/complete",
      "destination": "https://mafqoudat-production.up.railway.app/auth/complete"
    },
    {
      "source": "/auth/logout",
      "destination": "https://mafqoudat-production.up.railway.app/auth/logout"
    },
    {
      "source": "/auth/register",
      "destination": "https://mafqoudat-production.up.railway.app/auth/register"
    },
    {
      "source": "/auth",
      "destination": "https://mafqoudat-production.up.railway.app/auth"
    },
    {
      "source": "/users/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/users/:path*"
    },
    {
      "source": "/posts/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/posts/:path*"
    },
    {
      "source": "/notifications/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/notifications/:path*"
    },
    {
      "source": "/countries/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/countries/:path*"
    },
    {
      "source": "/cities/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/cities/:path*"
    },
    {
      "source": "/cities-public/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/cities-public/:path*"
    },
    {
      "source": "/cities-api/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/cities-api/:path*"
    },
    {
      "source": "/floptions/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/floptions/:path*"
    },
    {
      "source": "/categories/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/categories/:path*"
    },
    {
      "source": "/promotion/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/promotion/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/admin/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://mafqoudat-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://mafqoudat-production.up.railway.app wss://mafqoudat-production.up.railway.app https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://pagead2.googlesyndication.com; frame-src 'self' https://www.facebook.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(ads\\.txt|robots\\.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/push-sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpeg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.gif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/gif"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/webp"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.avif",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/avif"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(maflogoSVG|maficonSVG)\\.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.woff2",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/woff2"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.ttf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/ttf"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.eot",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.ms-fontobject"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
