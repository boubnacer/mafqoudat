# Production Environment Variables — TEMPLATE ONLY
# Copy this to configure your Render dashboard env vars (or a local .env for reference).
# Do NOT put real secret values in this file — it is committed to git.

NODE_ENV=production
# Render injects PORT automatically; 10000 is Render's typical default.
PORT=10000
NODE_OPTIONS=--max-old-space-size=400 --expose-gc
NODE_NO_WARNINGS=1

MONGODB_URI=
JWT_SECRET=
# Short-lived on purpose - sessions outlive this via the refresh-token flow
# (see server/utils/authSession.js). Do NOT set to 30d: that's the
# pre-refresh-token era and defeats fast logout/role-change revocation.
JWT_ACCESS_EXPIRES_IN=30m

FRONTEND_URL=https://mafqoudat.com
CLIENT_URL=https://mafqoudat.com
CORS_ALLOWED_ORIGINS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=
EMAIL_PASS=
EMAIL_SERVICE=gmail
EMAIL_USER=
SUPPORT_EMAIL=

GEONAMES_API_URL=http://api.geonames.org
GEONAMES_USERNAME=

# Render service URL: https://mafqoudat-api.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Native mobile Google OAuth clients (iOS/Android), accepted alongside
# GOOGLE_CLIENT_ID when verifying mobile ID tokens.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_PLACES_API_KEY=

# Render service URL: https://mafqoudat-api.onrender.com/auth/facebook/callback
FACEBOOK_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Page / Instagram auto-posting, and reading engagement back off those posts.
# views/engagedUsers/clicks (FB) and views/saved (IG) additionally need
# read_insights + instagram_manage_insights on the token; without them the
# counts still work and only those stay empty.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Optional tuning, see server/env.example for the full list:
# SOCIAL_STATS_TTL_MINUTES=180
# SOCIAL_STATS_YOUNG_TTL_MINUTES=10
# SOCIAL_STATS_YOUNG_POST_HOURS=24
# SOCIAL_STATS_FB_VIEW_METRICS=
# SOCIAL_STATS_FB_ENGAGED_METRICS=
# SOCIAL_STATS_FB_CLICKS_METRICS=
# SOCIAL_STATS_IG_VIEW_METRICS=
# SOCIAL_STATS_IG_SAVED_METRICS=

# Facebook Page webhook receiver - optional, see server/env.example. A string
# you make up, entered into the Meta App Dashboard's Webhooks setup.
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=

MAINTENANCE_MODE=false

# Not currently read by server code (session secret falls back to JWT_SECRET) —
# left here only in case that changes:
SESSION_SECRET=

# Push notifications (mobile). Optional; see mobile/PUSH_NOTIFICATIONS.md.
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_ACCESS_TOKEN=
