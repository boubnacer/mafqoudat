# Database Configuration
MONGODB_URI=mongodb://localhost:27017/mafqoudat
MONGODB_URI_PROD=mongodb+srv://username:password@cluster.mongodb.net/mafqoudat

# JWT Configuration
JWT_SECRET=your_jwt_secret_here

# Token Expiration Settings
# Access token expiry - short-lived by design. Sessions outlive this through
# the refresh-token flow (POST /auth/refresh + utils/authSession.js), which is
# what makes logout/role-change effective in minutes instead of 30 days.
# Do NOT set this to 30d - that was the pre-refresh-token era.
JWT_ACCESS_EXPIRES_IN=30m

# Cookie Security Configuration (Production)
COOKIE_DOMAIN=.mafqoudat.com

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3500/auth/google/callback
# For production (Render):
# GOOGLE_CALLBACK_URL=https://mafqoudat-api.onrender.com/auth/google/callback

# Native mobile Google OAuth clients (iOS/Android), used only by the mobile app's
# native Google sign-in (server/routes/mobileAuthRoutes.js). ID tokens issued to these
# clients carry the client's own ID as `aud`, so both must be accepted alongside
# GOOGLE_CLIENT_ID when verifying tokens.
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# Facebook OAuth Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3500/auth/facebook/callback
# For production (Render):
# FACEBOOK_CALLBACK_URL=https://mafqoudat-api.onrender.com/auth/facebook/callback

# Auto-posting to the Facebook Page / Instagram Business account, and reading
# the resulting engagement back (services/facebookService.js,
# instagramService.js, socialStatsService.js). One System User token carries
# both platforms' scopes.
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
# Graph API version used by every Meta call. Bump it here when Meta retires one.
# GRAPH_API_VERSION=v26.0

# Facebook Page webhook receiver (routes/facebookWebhookRoutes.js) - lets a
# reaction/comment/share refresh that one post's numbers within moments
# instead of waiting for the next poll. Optional: everything above still
# works without it, on the polling schedule alone. A string you make up
# yourself (not a secret from Meta) - entered into the App Dashboard's
# Webhooks setup as the "Verify Token" when registering the callback URL.
# Setup walkthrough: docs/facebook-webhooks.md.
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=choose_any_random_string

# How many of each platform's newest comments to pull in for the merged
# thread on a post page (controllers/commentsController.js). Context beside
# the site's own comments, not a mirror of the Page - the permalink is there
# for anyone who wants the rest. Set to 0 to keep the comment *counts* while
# fetching no comment text at all.
# SOCIAL_COMMENTS_LIMIT=25

# Social stats reader (all optional).
# How long stored engagement numbers count as fresh before a page view triggers
# a refetch, for a post that has settled. Social counters move slowly on an
# old listing - this is reach, not a live ticker.
# SOCIAL_STATS_TTL_MINUTES=180
# A much shorter window applies instead for the first SOCIAL_STATS_YOUNG_POST_HOURS
# of a post's life, since that is when its owner is actually watching for
# reactions - without this, the very first read (moments after creation,
# before anyone off-site could have reacted) locks the numbers for the long
# TTL regardless of what happens on the Page in between.
# SOCIAL_STATS_YOUNG_TTL_MINUTES=10
# SOCIAL_STATS_YOUNG_POST_HOURS=24
# SOCIAL_STATS_BATCH_SIZE=50
# SOCIAL_STATS_MAX_PER_RUN=50
# Insight metric names, tried in order until one answers, so a Meta rename is a
# config change rather than a deploy. Every insight-derived number below needs
# read_insights (Facebook) / instagram_manage_insights (Instagram); without
# those scopes the reactions, comments, likes and shares still work and only
# these stay empty. Each is resolved independently - a rename or a missing
# permission on one never costs the others.
# SOCIAL_STATS_FB_VIEW_METRICS=post_impressions_unique,post_impressions,post_views,post_views_unique
# Unique people who did something with the post, not just saw it.
# SOCIAL_STATS_FB_ENGAGED_METRICS=post_engaged_users
# Link/photo clicks specifically.
# SOCIAL_STATS_FB_CLICKS_METRICS=post_clicks
# SOCIAL_STATS_IG_VIEW_METRICS=views,reach,impressions
# Instagram's bookmark count.
# SOCIAL_STATS_IG_SAVED_METRICS=saved

# How long one viewer's visit to a post counts as the same view
# (middleware/postViewTracker.js).
# POST_VIEW_DEDUPE_MINUTES=30

# Session Secret (for OAuth sessions)
SESSION_SECRET=your_session_secret_here

# Server Configuration
PORT=3500
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://www.mafqoudat.com
# CLIENT_URL=https://www.mafqoudat.com

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Notification Configuration
# These are required for "Report Post" and "Increase Chances" features
ADMIN_EMAIL=your_admin_email@gmail.com
SUPPORT_EMAIL=support@mafqoudat.com

# Email Service Configuration (Gmail recommended)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
# For Gmail, use an App Password instead of your regular password
# Go to Google Account > Security > 2-Step Verification > App passwords
EMAIL_PASS=your_gmail_app_password

# Optional: For other email services
# EMAIL_SERVICE=outlook
# EMAIL_SERVICE=yahoo
# EMAIL_SERVICE=hotmail

# Redis Configuration (Optional - for distributed caching)
# If not provided, the app will use in-memory cache only
REDIS_URL=redis://localhost:6379 

# GeoNames API Configuration (for city search)
GEONAMES_USERNAME=your_geonames_username
GEONAMES_API_URL=http://api.geonames.org

# Google Places API (city-search fallback when DB + GeoNames have no match)
# Create an API key in Google Cloud Console with "Places API" enabled
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Push Notifications (mobile app) - all optional
# Delivery goes through Expo's push service, which already holds this project's
# FCM credentials, so there is no FCM key here. See mobile/PUSH_NOTIFICATIONS.md.
#
# Kill switch. Anything other than "false" leaves pushes on.
PUSH_NOTIFICATIONS_ENABLED=true
# Expo access token (expo.dev > Account settings > Access tokens). Optional, but
# without it anyone holding a scraped push token can send notifications that
# appear to come from this app - set it in production.
EXPO_ACCESS_TOKEN=
# How long to wait before asking Expo what became of a batch, so dead devices
# can be pruned. Clamped to 1s-15min; defaults to 5 minutes.
PUSH_RECEIPT_CHECK_DELAY_MS=300000
